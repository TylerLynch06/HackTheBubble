{
  "manifest_version": 3,
  "name": "Liquid Glass Ultra™",
  "version": "0.1.0",
  "description": "Our most liquid browser ever. Now with 0% solids.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Liquid Glass Ultra™",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "commands": {
    "toggle-liquid": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Panic button: drain / refill the liquid"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": [
        "src/effect-list.js",
        "src/core.js",
        "src/effects/glassify.js",
        "src/effects/wobble.js",
        "src/effects/slosh.js",
        "src/effects/drip.js",
        "src/effects/water-level.js",
        "src/effects/liquid-cursor.js",
        "src/effects/fluid-buttons.js",
        "src/effects/keynote.js",
        "src/boot.js"
      ]
    }
  ]
}
